block append foot-scripts
	//- Interactive Mathematical Particles Simulation
	script(nonce=scriptNonce).
		(function () {
			const canvas = document.getElementById('math-particles-canvas');
			if (!canvas) return;
			const ctx = canvas.getContext('2d');
			if (!ctx) return;

			let width = 0;
			let height = 0;
			let dpr = window.devicePixelRatio || 1;

			const mathSymbols = [
				'∫', '∑', '∂', '∇', 'ψ', 'ℏ', '∞', 'λ', 
				'α', 'Ω', 'Δ', '≈', 'π', '∈', '∀', '∃', 
				'∮', '√x', 'σ', 'θ', 'μ', 'φ'
			];

			const colors = [
				{ r: 236, g: 253, b: 245 }, // emerald-50 (luminous mint)
				{ r: 209, g: 250, b: 229 }, // emerald-100
				{ r: 167, g: 243, b: 208 }, // emerald-200
				{ r: 204, g: 251, b: 241 }, // teal-100
				{ r: 255, g: 255, b: 255 }  // crisp white highlight
			];

			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
			let isReduced = prefersReducedMotion.matches;
			prefersReducedMotion.addEventListener('change', (e) => {
				isReduced = e.matches;
			});

			const mouse = {
				x: -1000,
				y: -1000,
				active: false,
				radius: 175
			};

			window.addEventListener('mousemove', (e) => {
				mouse.x = e.clientX;
				mouse.y = e.clientY;
				mouse.active = true;
			});

			window.addEventListener('mouseleave', () => {
				mouse.active = false;
				mouse.x = -1000;
				mouse.y = -1000;
			});

			function resize() {
				width = window.innerWidth;
				height = window.innerHeight;
				dpr = window.devicePixelRatio || 1;
				canvas.width = Math.floor(width * dpr);
				canvas.height = Math.floor(height * dpr);
				ctx.setTransform(1, 0, 0, 1, 0, 0);
				ctx.scale(dpr, dpr);
			}

			window.addEventListener('resize', resize);
			resize();

			class Particle {
				constructor() {
					this.reset(true);
				}

				reset(init = false) {
					this.symbol = mathSymbols[Math.floor(Math.random() * mathSymbols.length)];
					this.color = colors[Math.floor(Math.random() * colors.length)];
					this.fontSize = Math.floor(Math.random() * 11) + 18; // 18px to 28px
					
					this.x = Math.random() * (width || window.innerWidth);
					this.y = init ? Math.random() * (height || window.innerHeight) : height + 30;

					// Base gentle ambient drift
					this.vx = (Math.random() - 0.5) * 0.28;
					this.vy = -(Math.random() * 0.45 + 0.15); // gentle upwards drift

					// Extra impulse from mouse repelling
					this.fx = 0;
					this.fy = 0;

					// Rotation & wobble
					this.angle = (Math.random() - 0.5) * 0.4;
					this.angularSpeed = (Math.random() - 0.5) * 0.005;
					this.wobblePhase = Math.random() * Math.PI * 2;
					this.wobbleSpeed = Math.random() * 0.015 + 0.008;

					// Opacity oscillation adjusted for clear contrast on lighter green background
					this.baseOpacityMin = 0.20 + Math.random() * 0.08;
					this.baseOpacityMax = 0.52 + Math.random() * 0.15;
					this.pulsePhase = Math.random() * Math.PI * 2;
					this.pulseSpeed = Math.random() * 0.02 + 0.01;
				}

				update() {
					if (isReduced) {
						this.pulsePhase += 0.005;
						return;
					}

					this.pulsePhase += this.pulseSpeed;
					this.wobblePhase += this.wobbleSpeed;
					this.angle += this.angularSpeed;

					// Mouse interactive swirl / repulsion
					if (mouse.active) {
						const dx = this.x - mouse.x;
						const dy = this.y - mouse.y;
						const distSq = dx * dx + dy * dy;
						const rSq = mouse.radius * mouse.radius;

						if (distSq < rSq && distSq > 0.1) {
							const dist = Math.sqrt(distSq);
							const force = (1 - dist / mouse.radius);
							const normalX = dx / dist;
							const normalY = dy / dist;

							// Repel gently + slight tangential swirl
							const swirlX = -normalY * 0.8;
							const swirlY = normalX * 0.8;

							this.fx += (normalX * 1.8 + swirlX) * force * 0.85;
							this.fy += (normalY * 1.8 + swirlY) * force * 0.85;
						}
					}

					// Apply velocity dampening to impulses
					this.fx *= 0.93;
					this.fy *= 0.93;

					// Apply natural movement + wobble
					const wobbleX = Math.sin(this.wobblePhase) * 0.25;
					this.x += this.vx + wobbleX + this.fx;
					this.y += this.vy + this.fy;

					// Wrap around viewport edges smoothly
					if (this.y < -40) {
						this.y = height + 30;
						this.x = Math.random() * width;
					} else if (this.y > height + 40) {
						this.y = -30;
					}

					if (this.x < -40) {
						this.x = width + 30;
					} else if (this.x > width + 40) {
						this.x = -30;
					}
				}

				draw() {
					const norm = (Math.sin(this.pulsePhase) + 1) / 2; // 0 to 1
					const alpha = this.baseOpacityMin + norm * (this.baseOpacityMax - this.baseOpacityMin);

					ctx.save();
					ctx.translate(this.x, this.y);
					ctx.rotate(this.angle);

					ctx.font = `italic ${this.fontSize}px "Newsreader", "KaTeX_Math", "Cambria Math", "Times New Roman", serif`;
					ctx.textAlign = 'center';
					ctx.textBaseline = 'middle';
					ctx.shadowColor = 'rgba(255, 255, 255, 0.35)';
					ctx.shadowBlur = 6;
					ctx.fillStyle = `rgba(${this.color.r}, ${this.color.g}, ${this.color.b}, ${alpha})`;

					ctx.fillText(this.symbol, 0, 0);
					ctx.restore();
				}
			}

			const particleCount = Math.max(32, Math.min(65, Math.floor((window.innerWidth * window.innerHeight) / 24000)));
			const particles = [];
			for (let i = 0; i < particleCount; i++) {
				particles.push(new Particle());
			}

			let animId;
			function animate() {
				ctx.clearRect(0, 0, width, height);
				for (let i = 0; i < particles.length; i++) {
					particles[i].update();
					particles[i].draw();
				}
				animId = requestAnimationFrame(animate);
			}

			animId = requestAnimationFrame(animate);
		})();

	//- Clerk Client Integration & Session Bridging
	script(nonce=scriptNonce).
		(function () {
			var mount = document.getElementById('clerk-signin');
			if (!mount) return;
			var status = document.getElementById('clerk-status');
			var errorBox = document.getElementById('clerk-error');
			var publishableKey = mount.getAttribute('data-publishable-key');
			var frontendApi = mount.getAttribute('data-frontend-api');
			var csrf = mount.getAttribute('data-csrf');
			var signInUrl = window.location.origin + '/login';
			var signUpUrl = window.location.origin + '/login#/sign-up';
			var bridged = false;

			function showError(text) {
				if (!errorBox) return;
				errorBox.textContent = text;
				errorBox.hidden = false;
				if (status) status.hidden = true;
			}

			function showStatus(text) {
				if (!status) return;
				status.textContent = text;
				status.hidden = false;
			}

			var initGoogleBtn = document.getElementById('init-google-btn');
			if (initGoogleBtn) {
				initGoogleBtn.addEventListener('click', function () {
					if (window.Clerk && window.Clerk.openSignIn) {
						window.Clerk.openSignIn();
					} else {
						showStatus('Connecting to Google sign-in…');
					}
				});
			}

			var initEmailForm = document.getElementById('init-email-form');
			if (initEmailForm) {
				initEmailForm.addEventListener('submit', function (e) {
					e.preventDefault();
					var emailInput = document.getElementById('init-email-input');
					var email = emailInput ? emailInput.value.trim() : '';
					if (!email) return;
					if (window.Clerk && window.Clerk.client && window.Clerk.client.signIn) {
						showStatus('Connecting…');
						window.Clerk.client.signIn.create({ identifier: email })
							.then(function () {
								render();
							})
							.catch(function (err) {
								showError((err && err.errors && err.errors[0] && err.errors[0].message) || 'Sign-in failed.');
							});
					} else {
						showStatus('Connecting…');
					}
				});
			}

			if (!publishableKey || !frontendApi) {
				showError('Google sign-in is not configured on this instance yet. Use the admin login link below, or ask the administrator to finish the Clerk setup.');
				return;
			}

			var appearance = {
				variables: {
					colorPrimary: '#047857',
					colorText: '#0f172a',
					colorTextSecondary: '#64748b',
					colorBackground: '#ffffff',
					colorInputBackground: '#f8fafc',
					colorInputText: '#0f172a',
					borderRadius: '0.75rem',
					fontFamily: 'Inter, system-ui, sans-serif'
				},
				elements: {
					card: {
						backgroundColor: 'transparent',
						boxShadow: 'none',
						border: 'none',
						padding: '0',
						width: '100%'
					},
					cardBox: {
						boxShadow: 'none',
						border: 'none',
						borderRadius: '0',
						overflow: 'visible'
					},
					header: { display: 'none' },
					socialButtonsBlockButton: {
						height: '50px',
						borderRadius: '12px',
						fontWeight: '600',
						border: '1px solid #e2e8f0',
						backgroundColor: '#ffffff',
						fontSize: '14px',
						color: '#334155'
					},
					formButtonPrimary: {
						height: '48px',
						borderRadius: '12px',
						background: 'linear-gradient(to right, #065f46, #047857)',
						fontWeight: '600',
						fontSize: '14px'
					},
					formFieldInput: {
						borderRadius: '12px',
						backgroundColor: '#f8fafc',
						border: '1px solid #e2e8f0',
						height: '48px',
						fontSize: '14px'
					},
					footer: { fontSize: '11px', opacity: '0.75' }
				}
			};

			function bridge(session) {
				if (bridged) return;
				bridged = true;
				showStatus('Signing you in…');
				session.getToken().then(function (token) {
					return fetch('/auth/clerk', {
						method: 'POST',
						headers: {
							'Content-Type': 'application/x-www-form-urlencoded',
							'Accept': 'application/json'
						},
						body: new URLSearchParams({ _csrf: csrf, token: token })
					});
				}).then(function (response) {
					return response.json().catch(function () { return {}; }).then(function (data) {
						if (response.ok && data.redir) {
							window.location.assign(data.redir);
							return;
						}
						bridged = false;
						showError((data.message && data.message.text) || 'Sign-in failed. Please try again.');
					});
				}).catch(function () {
					bridged = false;
					showError('Sign-in failed. Please try again.');
				});
			}

			function unmount() {
				try { window.Clerk.unmountSignIn(mount); } catch (e) {}
				try { window.Clerk.unmountSignUp(mount); } catch (e) {}
				mount.innerHTML = '';
			}

			function render() {
				unmount();
				if (window.location.hash === '#/sign-up') {
					window.Clerk.mountSignUp(mount, {
						appearance: appearance,
						signInUrl: signInUrl
					});
				} else {
					window.Clerk.mountSignIn(mount, {
						appearance: appearance,
						signUpUrl: signUpUrl
					});
				}
			}

			function loadScript(src) {
				return new Promise(function (resolve, reject) {
					var script = document.createElement('script');
					script.src = src;
					script.async = true;
					script.crossOrigin = 'anonymous';
					script.setAttribute('data-clerk-publishable-key', publishableKey);
					script.setAttribute('data-clerk-frontend-api', frontendApi);
					script.onload = resolve;
					script.onerror = function () { reject(new Error('Failed to load Clerk.js')); };
					document.head.appendChild(script);
				});
			}

			var signedOut = new URLSearchParams(window.location.search).get('logged_out') === '1';

			loadScript('https://' + frontendApi + '/npm/@clerk/clerk-js@5/dist/clerk.browser.js')
				.then(function () { return window.Clerk.load(); })
				.then(async function () {
					if (signedOut) {
						history.replaceState(null, '', window.location.pathname);
						if (window.Clerk.session) {
							try {
								await window.Clerk.signOut({
									redirectUrl: window.location.origin + '/login'
								});
							} catch (e) {}
						}
						showStatus('You have been signed out.');
						render();
						return;
					}
					if (window.Clerk.session) {
						bridge(window.Clerk.session);
						return;
					}
					render();
					window.Clerk.addListener(function (resources) {
						if (resources.session) bridge(resources.session);
					});
				})
				.catch(function () {
					// Fallback: the pre-rendered UI remains active
				});
		})();
