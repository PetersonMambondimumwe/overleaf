extends ../layout-website-redesign

block vars
	- isWebsiteRedesign = true
	- suppressNavbar = true
	- suppressFooter = true

block append head-scripts
	//- Inter, Fira Code and Newsreader Fonts
	link(rel="preconnect" href="https://fonts.googleapis.com")
	link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin="")
	link(href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@300;400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;1,6..72,400&display=swap" rel="stylesheet")

	//- Tailwind CSS v3 Engine
	script(nonce=scriptNonce src="https://cdn.tailwindcss.com?plugins=forms,container-queries")
	script(nonce=scriptNonce).
		tailwind.config = {
			theme: {
				extend: {
					fontFamily: {
						sans: ['Inter', 'system-ui', 'sans-serif'],
						mono: ['"Fira Code"', 'monospace'],
						serif: ['Newsreader', 'serif'],
					},
					colors: {
						emerald: {
							850: '#0e4a30',
							925: '#073321',
							950: '#032316',
						}
					},
					boxShadow: {
						'glow-emerald': '0 0 50px -10px rgba(16, 185, 129, 0.28)',
						'card-elevated': '0 25px 60px -15px rgba(6, 44, 30, 0.35), 0 0 1px 1px rgba(255, 255, 255, 0.2)',
					}
				}
			}
		}

block append css
	style.
		body.website-redesign {
			background: transparent !important;
			margin: 0 !important;
			padding: 0 !important;
			overflow-x: hidden !important;
		}
		.ol-clerk-page-wrapper {
			min-height: 100vh;
			min-height: 100dvh;
			display: flex;
			flex-direction: column;
			align-items: center;
			justify-content: center;
			padding: 1.5rem 1rem 2rem;
			position: relative;
			background: linear-gradient(135deg, #064e3b 0%, #115e59 50%, #047857 100%);
			font-family: 'Inter', system-ui, sans-serif;
			selection-background-color: #10b981;
			selection-color: #ffffff;
		}
		.academic-grid-pattern {
			background-size: 32px 32px;
			background-image: 
				linear-gradient(to right, rgba(5, 150, 105, 0.12) 1px, transparent 1px),
				linear-gradient(to bottom, rgba(5, 150, 105, 0.12) 1px, transparent 1px);
		}
		.code-glass {
			background: rgba(4, 38, 25, 0.72);
			backdrop-filter: blur(12px);
			-webkit-backdrop-filter: blur(12px);
		}
		.shadow-card-elevated {
			box-shadow: 0 25px 60px -15px rgba(6, 44, 30, 0.35), 0 0 1px 1px rgba(255, 255, 255, 0.2);
		}
		.shadow-glow-emerald {
			box-shadow: 0 0 50px -10px rgba(16, 185, 129, 0.28);
		}

		/* Clerk Theme and Alignment Overrides */
		#clerk-signin .cl-rootBox,
		#clerk-signin .cl-card {
			box-shadow: none !important;
			border: 0 !important;
			padding: 0 !important;
			background: transparent !important;
			width: 100% !important;
		}
		#clerk-signin .cl-header {
			display: none !important;
		}
		#clerk-signin .cl-socialButtonsBlockButton {
			height: 50px !important;
			border-radius: 12px !important;
			border: 1px solid #e2e8f0 !important;
			background-color: #ffffff !important;
			color: #334155 !important;
			font-weight: 600 !important;
			font-size: 14px !important;
			box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05) !important;
			transition: all 0.2s ease !important;
			display: flex !important;
			align-items: center !important;
			justify-content: center !important;
			gap: 12px !important;
		}
		#clerk-signin .cl-socialButtonsBlockButton:hover {
			background-color: #f8fafc !important;
			border-color: #cbd5e1 !important;
			box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.07) !important;
		}
		#clerk-signin .cl-dividerLine {
			background-color: #e2e8f0 !important;
		}
		#clerk-signin .cl-dividerText {
			color: #94a3b8 !important;
			font-size: 12px !important;
			text-transform: uppercase !important;
			letter-spacing: 0.05em !important;
			font-weight: 500 !important;
		}
		#clerk-signin .cl-formFieldLabel {
			font-size: 12px !important;
			font-weight: 600 !important;
			color: #334155 !important;
			text-transform: uppercase !important;
			letter-spacing: 0.05em !important;
			margin-bottom: 8px !important;
		}
		#clerk-signin .cl-formFieldInput {
			border-radius: 12px !important;
			background-color: #f8fafc !important;
			border: 1px solid #e2e8f0 !important;
			height: 48px !important;
			font-size: 14px !important;
			color: #0f172a !important;
			padding: 0 16px !important;
			transition: all 0.2s ease !important;
		}
		#clerk-signin .cl-formFieldInput:focus {
			background-color: #ffffff !important;
			border-color: #059669 !important;
			box-shadow: 0 0 0 4px rgba(5, 150, 105, 0.1) !important;
		}
		#clerk-signin .cl-formButtonPrimary {
			height: 48px !important;
			border-radius: 12px !important;
			background: linear-gradient(to right, #065f46, #047857) !important;
			font-weight: 600 !important;
			font-size: 14px !important;
			color: #ffffff !important;
			box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1) !important;
			transition: all 0.2s ease !important;
		}
		#clerk-signin .cl-formButtonPrimary:hover {
			background: linear-gradient(to right, #047857, #059669) !important;
			box-shadow: 0 0 50px -10px rgba(16, 185, 129, 0.28) !important;
		}
		#clerk-signin .cl-footerActionLink {
			color: #065f46 !important;
			font-weight: 600 !important;
		}
		#clerk-signin .cl-footerActionLink:hover {
			color: #047857 !important;
			text-decoration: underline !important;
		}

