# ─────────────────────────────────────────────────────────────────────
#  Overleaf — self-hosted configuration
#  Copy this file to .env, then edit the values:
#      cp .env.example .env
#  See SELFHOST.md for the full deployment guide.
# ─────────────────────────────────────────────────────────────────────

# Public URL of your instance, no trailing slash.
# Local:   http://localhost        (or http://localhost:8080 if you change the port)
# Server:  https://overleaf.your-domain.com
OVERLEAF_SITE_URL=http://localhost

# Host port that serves Overleaf. 80 for production; use 8080 locally if 80 is taken.
OVERLEAF_PORT=80

# Name shown in the header, browser tab and emails.
OVERLEAF_APP_NAME=Overleaf

# Admin address; receives system notifications and is used for the first admin account.
OVERLEAF_ADMIN_EMAIL=you@example.com

# Signs invite tokens. Generate one with:  openssl rand -base64 32
# Never commit the real value — .env is git-ignored.
OVERLEAF_INVITE_TOKEN_SECRET=change-me-to-a-random-secret

# Pin the Overleaf image for reproducible deployments (e.g. latest, or a date tag).
OVERLEAF_IMAGE_TAG=latest

# ---- Google sign-in via Clerk ---------------------------------------
# When enabled, /login shows the Google sign-in page and /login/classic keeps
# password login available (admin fallback).
# Create/link the Clerk application and copy the keys from `clerk env pull`.
OVERLEAF_CLERK_ENABLED=false
OVERLEAF_CLERK_PUBLISHABLE_KEY=
OVERLEAF_CLERK_SECRET_KEY=
# Comma-separated list of email domains allowed to auto-create an account.
# Leave empty to allow every verified Google address.
OVERLEAF_CLERK_ALLOWED_DOMAINS=tuks.co.za

# ---- Optional outgoing email ----------------------------------------
# Without SMTP, password resets and invite emails are written to the container logs.
# OVERLEAF_EMAIL_FROM_ADDRESS=overleaf@example.com
# OVERLEAF_EMAIL_SMTP_HOST=smtp.example.com
# OVERLEAF_EMAIL_SMTP_PORT=587
# OVERLEAF_EMAIL_SMTP_SECURE=false
# OVERLEAF_EMAIL_SMTP_USER=
# OVERLEAF_EMAIL_SMTP_PASS=
# OVERLEAF_EMAIL_SMTP_TLS_REJECT_UNAUTH=true
# OVERLEAF_EMAIL_SMTP_IGNORE_TLS=false

# ---- AI writing assistant (optional) --------------------------------
# When ANTHROPIC_API_KEY is set, an "AI Assist" button appears in the editor.
# Default model is Claude 3.5 Haiku, the fastest and most cost-effective Claude model.
# ANTHROPIC_API_KEY=sk-ant-...
# OVERLEAF_AI_MODEL=claude-3-5-haiku-latest
# OVERLEAF_AI_MAX_INPUT_CHARS=6000
# OVERLEAF_AI_MAX_OUTPUT_TOKENS=1024
# OVERLEAF_AI_REQUESTS_PER_MINUTE=15
